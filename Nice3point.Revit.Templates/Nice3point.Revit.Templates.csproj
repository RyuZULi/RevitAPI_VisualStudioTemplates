<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <PackageType>Template</PackageType>
        <!-- 必須跟官方 Nice3point.Revit.Templates 不同 ID，否則安裝時會覆蓋掉對方的官方套件，
             這樣就失去了樣板短名稱加 -self 後綴（可與官方並存）的意義 -->
        <PackageId>Nice3point.Revit.Templates.Self</PackageId>
        <Version>6.2.3.4</Version>
        <Authors>CEC</Authors>
        <Description>CEC 內部使用的 Revit 外掛開發樣板，基於 Nice3point/RevitTemplates v6.2.0 客製化。短名稱皆帶 -self 後綴，可與官方 Nice3point.Revit.Templates 並存。需要 Visual Studio 2026 或 dotnet SDK 10 以上才能建置產生的專案。</Description>
        <PackageTags>autodesk;revit;templates;addin;cec</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <PropertyGroup>
        <IsPackable>true</IsPackable>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <EnableDefaultItems>false</EnableDefaultItems>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <IncludeContentInPack>true</IncludeContentInPack>
        <ContentTargetFolders>content</ContentTargetFolders>
        <DevelopmentDependency>true</DevelopmentDependency>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    </PropertyGroup>

    <ItemGroup>
        <!-- 官方 repo 的版面是 source\Nice3point.Revit.Templates\，所以 ..\..\ 是 repo 根目錄。
             這個 repo 少一層，..\ 才是根目錄；官方的 PackageIcon.png / License.md 也沒有一起 clone 進來 -->
        <None Include="..\README.md" PackagePath="" Pack="true" Visible="false"/>
        <Content Include="**\*" Exclude="**\bin\**\*;**\obj\**\*;*.csproj"/>
    </ItemGroup>

</Project>