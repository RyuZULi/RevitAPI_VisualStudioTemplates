<Project Sdk="Nice3point.Revit.Sdk/6.2.3">

    <PropertyGroup>
<!--#if (!isDbApplicationAddin)-->
        <UseWPF>true</UseWPF>
<!--#endif-->
        <UseWindowsForms>true</UseWindowsForms>
        <PlatformTarget>x64</PlatformTarget>
        <DeployAddin>false</DeployAddin>
        <LaunchRevit>true</LaunchRevit>
        <IsRepackable>false</IsRepackable>
        <EnableDynamicLoading>true</EnableDynamicLoading>
        <Configurations>Debug.R21;Debug.R23;Debug.R24;Debug.R25;Debug.R26;Debug.R27</Configurations>
        <Configurations>$(Configurations);Release.R21;Release.R23;Release.R24;Release.R25;Release.R26;Release.R27</Configurations>
        <RootNamespace Condition="'$(name)' != '$(name{-VALUE-FORMS-}safe_namespace)'">Nice3point.Revit.AddIn._1</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Revit Dependencies -->
        <PackageReference Include="Nice3point.Revit.Toolkit" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Extensions" Version="$(RevitVersion).*"/>
        <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*"/>
<!--#if (!isDbApplicationAddin)-->
        <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*"/>
<!--#endif-->

        <!-- CEC Dependencies -->
        <PackageReference Include="CEC_Common" Version="1.0.4"/>
        <PackageReference Include="Microsoft.Office.Interop.Excel" Version="16.0.18925.20022"/>
<!--#if (diContainer)-->

        <!-- Application Hosting -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.5"/>
<!--#endif-->
<!--#if (diHosting)-->

        <!-- Application Hosting -->
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.5"/>
<!--#endif-->
<!--#if (addinLogging)-->

        <!-- Logging -->
        <PackageReference Include="Serilog" Version="4.3.1"/>
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0"/>
<!--#endif-->
<!--#if (useUi)-->

        <!-- MVVM -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2"/>
<!--#endif-->
<!--#if (addinLogging && diHosting)-->
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0"/>
<!--#endif-->
<!--#if (addinLogging || useDi)-->

        <!-- Build Automation-->
        <PackageReference Include="ILRepack" Version="2.0.44"/>
<!--#endif-->

        <!-- Development Dependencies -->
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.4" PrivateAssets="all"/>
        <PackageReference Include="Polyfill" Version="10.0.0" PrivateAssets="all"/>
    </ItemGroup>

    <!-- .NET Framework 需要顯式參考 Microsoft.CSharp 才能使用 dynamic（Excel COM 晚期繫結會用到）。
         .NET 5+ 已內建於執行階段，不需要也不能這樣參考，所以用 TargetFrameworkIdentifier 條件隔開 -->
    <ItemGroup Condition="'$(TargetFrameworkIdentifier)' == '.NETFramework'">
        <Reference Include="Microsoft.CSharp"/>
    </ItemGroup>
    
<!--#if (isApplicationAddin)-->
    <ItemGroup>
        <Resource Include="Resources\Icons\RibbonIcon16.png"/>
        <Resource Include="Resources\Icons\RibbonIcon32.png"/>
    </ItemGroup>

<!--#endif-->
    <ItemGroup>
        <None Remove="Resources\CEC.ico"/>
    </ItemGroup>
    <ItemGroup>
        <Resource Include="Resources\CEC.ico"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Update="Properties\Resources.Designer.cs">
            <DesignTime>True</DesignTime>
            <AutoGen>True</AutoGen>
            <DependentUpon>Resources.resx</DependentUpon>
        </Compile>
    </ItemGroup>
    <ItemGroup>
        <EmbeddedResource Update="Properties\Resources.resx">
            <Generator>PublicResXFileCodeGenerator</Generator>
            <LastGenOutput>Resources.Designer.cs</LastGenOutput>
        </EmbeddedResource>
    </ItemGroup>

<!--#if (useUi)-->
    <ItemGroup>
        <Folder Include="Models"/>
    </ItemGroup>

<!--#endif-->
    <!-- 讓 Microsoft.Office.Interop.Excel 改用內嵌 Interop 型別（csc 的 /link:），
         這樣輸出就不必帶 1.7 MB 的 Interop DLL，也不會跟其他外掛的版本互撞。
         注意：不能寫成 <PackageReference><EmbedInteropTypes>true</EmbedInteropTypes></PackageReference>，
         NuGet 不會把這個 metadata 傳遞下去，會被靜默忽略。必須等 ResolveReferences
         把套件展開成一顆顆組件之後，直接在 ReferencePath 上補標記 -->
    <Target Name="EmbedExcelInterop" AfterTargets="ResolveReferences">
        <!-- 組件名稱刻意透過屬性間接引用，不要寫成字面值。dotnet new 的模板引擎會去評估
             Condition 屬性，看到純字面比較且結果為 false 就把整個元素從產出檔中刪掉；
             條件裡只要含 $(...) 它就無法解析而放行 -->
        <PropertyGroup>
            <ExcelInteropAssembly>Microsoft.Office.Interop.Excel</ExcelInteropAssembly>
        </PropertyGroup>
        <ItemGroup>
            <ReferencePath Condition="'%(FileName)' == '$(ExcelInteropAssembly)'">
                <EmbedInteropTypes>true</EmbedInteropTypes>
            </ReferencePath>
            <!-- 型別已經內嵌進主組件，執行階段不會再去載入這顆 Interop DLL
                 （編出來的組件 AssemblyRef 裡根本沒有它），所以也不必複製到輸出目錄。
                 要在這個 target 裡做，因為 ReferenceCopyLocalPaths 是 ResolveReferences
                 執行時才產生的，專案檔頂層的 ItemGroup 那時候還讀不到 -->
            <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(FileName)' == '$(ExcelInteropAssembly)'"/>
        </ItemGroup>
    </Target>

</Project>